# Fichiers sensibles (ne pas commiter)
config.py
.env

# Fichiers de cache Python
__pycache__/
*.py[cod]
*$py.class

# Fichiers de cache et logs
.cache/
*.log

# Fichiers IDE (ex: VS Code, PyCharm)
.vscode/
.idea/

# Fichiers de données temporaires
*.csv
*.json
data/

# Fichiers de dépendances (si tu utilises pip sans venv)
*.egg-info/
dist/
build/

# Fichiers de configuration locale
*.local
